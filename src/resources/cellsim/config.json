{
    "$schema": "./schema.json",
    "cell": {
        "cells": [
           {
            "behaviorType": "Normal",
            "cellCount": 1000,
            "color": "#00FFFF",
            "mass": 1.0,
            "radius": 10.0,
            "typeName": "Cell1",

            "modelParameters": {
                "cellGrowth": {
                    "adhesiveRepulsionFactor": 1
                },
                
                "clusterFormation": {
                    "adhesiveRepulsionFactor": 10.0,
                    "lambda": 20.0,
                    "remoteForceFactor": 1.0
                },

                "clusterRotation": {
                    "adhesionDistanceThreshold": 50.0,
                    "adhesionForceFactor": 1.0,
                    "centralForceFactor": 1.0,
                    "repulsionFactor": 10.0,
                    "repulsionMaxDistance": 15.0
                },

                "clusterSprouting": {
                    "adhesionThreshold": 3,
                    "coefficientCd": 10.0,
                    "followerAttractionFactor": 2.0,
                    "globalAttractionFactor": 0.05,
                    "lambda": 20.0,
                    "leaderRepulsionFactor": 2.0,
                    "leaderRepulsionMaxDistance": 150.0,
                    "leaderRepulsionMinDistance": 80.0
                },

                "networkFormation": {
                    "adhesiveRepulsionFactor": 200,
                    "attractionFactor": 0.3,
                    "lambda": 0.01,
                    "maxRepulsionDistance": 25,
                    "minAttractionDistance": 80,
                    "remoteForceFactor": 0.01
                }
            }
           }
        ],
        "enableGrowth": false,
        "initialPlacementRadius": 512,
        "initialPlacementSeed": 0,
        "isSensitiveToMolecules": false
    },
    "optimization": {
        "maxDegreeOfParallelism": -1,
        "peformance": "Fast"
    },
    "simulation": {
        "deltaTime": 0.1,
        "enable2dMode": true,
        "fieldRadius": 512,
        "imageSize": 720,
        "outputInterval": 5,
        "totalSteps": 1000
    },
    "simulationModel": {
        "simulationType": "ClusterFormation",

        "clusterSprouting": {
            "contactDistance": 20.0
        },

        "networkFormation": {
            "maxAttractionDistance": 100
        }
    },
    "cellBehavior": {
        "normal": {
            "cellDivisionRadius": 18,
            "growthRate": 0.03
        },

        "wavePropagation": {
            "cellDivisionRadius": 18,
            "degradationRate": 1,
            "synthesisRate": 1,
            "alpha": 0,
            "c": 0,
            "epsilon": 0,
            "h": 0,
            "k1": 0,
            "k2": 0,
            "ke": 0,
            "ki": 0,
            "kt": 0,
            "l1": 0,
            "l2": 0,
            "lambda": 0,
            "q": 0,
            "sigma": 0,
            "theta": 0
        }
    },
    "cellAlgorithm": {
        "algorithmType": "CellList",
        "useClusterModel": false,

        "cellList": {
            "gridCount": 32,
            "searchRadius": 64
        }
    },
    "molecular": [
        {
            "behaviorType": "Normal",
            "boundaryCondition": "Absorbing",
            "colorIntensityThreshold": 100,
            "gridCount": 256,
            "initialDistribution": "Uniform",
            "moleculeAmount": 300000,
            "moleculeKind": "Molecule1",

            "normalBehavior": {
                "diffusionFactor": 0.1
            }
        }
    ]
}