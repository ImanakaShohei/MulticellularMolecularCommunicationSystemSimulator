{
    "$schema": "./schema.json",
    "cell": {
        "cellCount": 1000,
        "enableGrowth": false,
        "growthRate": 0.03,
        "initialPlacementRadius": 512,
        "initialPlacementSeed": 0,
        "isSensitiveToMolecules": false,
        "mass": 1.0,
        "radius": 10.0,
        "type": "Normal"
    },
    "cellBehavior": {
        "behaviorType": "Normal",
        "normal": {
            "cellDivisionRadius": 18
        }
    },
    "optimization": {
        "peformance": "Fast"
    },
    "simulation": {
        "deltaTime": 0.1,
        "enable2DMode": true,
        "fieldRadius": 512,
        "outputInterval": 5,
        "totalSteps": 1000
    },
    "simulationModel": {
        "simulationType": "ClusterFormation",

        "cellGrowth": {
            "adhesiveRepulsionFactor": 1
        },
        
        "clusterFormation": {
            "adhesiveRepulsionFactor": 1.0,
            "lambda": 20.0,
            "remoteForceFactor": 1.0
        },

        "networkFormation": {
            "adhesiveRepulsionFactor": 200,
            "attractionFactor": 0.3,
            "lambda": 0.01,
            "maxAttractionDistance": 100,
            "maxRepulsionDistance": 25,
            "minAttractionDistance": 80,
            "remoteForceFactor": 0.01
        }
    },
    "cellAlgorithm": {
        "algorithmType": "CellList",
        "useClusterModel": false,

        "cellList": {
            "gridCount": 32,
            "searchRadius": 64
        }
    }
}