{
    "$schema": "./schema.json",
    "cell": {
        "cellCount": 1000,
        "enableGrowth": false,
        "growthRate": 0.03,
        "initialPlacementRadius": 512,
        "initialPlacementSeed": 0,
        "isSensitiveToMolecules": false,
        "mass": 1.0,
        "radius": 10.0,
        "type": "Normal"
    },
    "cellBehavior": {
        "behaviorType": "Normal",
        "normal": {
            "cellDivisionRadius": 18
        }
    },
    "optimization": {
        "peformance": "Fast"
    },
    "simulation": {
        "deltaTime": 10,
        "enable2DMode": true,
        "fieldRadiusX": 512,
        "fieldRadiusY": 512,
        "fieldRadiusZ": 0,
        "outputInterval": 5,
        "totalSteps": 1000
    },
    "simulationModel": {
        "simulationType": "ClusterFormation",
        
        "clusterFormation": {
            "adhesiveRepulsionFactor": 1.0,
            "lambda": 20.0,
            "remoteForceFactor": 1.0
        }
    },
    "cellAlgorithm": {
        "algorithmType": "CellList",
        "useClusterModel": false,

        "cellList": {
            "gridCountX": 32,
            "gridCountY": 32,
            "gridCountZ": 1,
            "searchRadius": 64
        }
    }
}