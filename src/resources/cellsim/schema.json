{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "cellsim config",
    "$defs": {
        "description": {
            "type": "object",
            "properties": {
                "language": { "type": "string", "examples": [ "en-us", "ja-jp" ] },
                "text": { "type": "string" }
            },
            "required": [
                "language",
                "text"
            ]
        },
        "descriptions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/description"
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "moleculeField": {
            "type": "object",
            "properties": {
                "moleculeKind": {
                    "type": "string"
                }
            }
        }
    },
    "properties": {
        "cell": {
            "type": "object",
            "title": "cell congfig",
            "properties": {
                "cellCount": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                },
                "enableGrowth": { "type": "boolean" },
                "growthRate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "initialPlacementRadius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "initialPlacementSeed": {
                    "type": "integer",
                    "minimum": 0
                },
                "isSensitiveToMolecules": { "type": "boolean" },
                "mass": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "type": {
                    "type": "string",
                    "enum": [ "Normal" ]
                }
            },
            "required": [ "cellCount", "enableGrowth", "growthRate", "initialPlacementRadius", "initialPlacementSeed", "isSensitiveToMolecules", "mass", "radius", "type" ]
        },
        "cellAlgorithm": {
            "type": "object",
            "title": "cellAlgorithm config",
            "properties": {
                "algorithmType": {
                    "type": "string",
                    "enum": [ "BarnesHut", "CellList", "Naive", "Null", "ParticleMesh", "User" ]
                },
                "useClusterModel": { "type": "boolean" },
                "barnesHut": { "type": "object" },
                "cellList": {
                    "properties": {
                        "gridCount": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                        },
                        "searchRadius": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "gridCount", "searchRadius" ]
                },
                "particleMesh": { "type": "object" },
                "user": { "type": "object" }
            },
            "required": [ "algorithmType", "useClusterModel" ]
        },
        "cellBehavior": {
            "type": "object",
            "properties": {
                "behaviorType": {
                    "type": "string",
                    "enum": [ "MoleculeAware", "Normal", "User", "WavePropagation" ]
                },
                "moleculeAware": {
                    "type": "object",
                    "properties": {
                        "cellDivisionRadius": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "degradationRate": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "synthesisRate": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "cellDivisionRadius", "degradationRate", "synthesisRate" ]
                },
                "normal": {
                    "type": "object",
                    "properties": {
                        "cellDivisionRadius": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "cellDivisionRadius" ]
                },
                "user": { "type": "object" },
                "wavePropagation": {
                    "type": "object",
                    "properties": {
                        "cellDivisionRadius": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "degradationRate": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "synthesisRate": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "c": { "type": "number" },
                        "k1": { "type": "number" },
                        "k2": { "type": "number" },
                        "l1": { "type": "number" },
                        "l2": { "type": "number" },
                        "q": { "type": "number" },
                        "sigma": { "type": "number" },
                        "ki": { "type": "number" },
                        "ke": { "type": "number" },
                        "kt": { "type": "number" },
                        "alpha": { "type": "number" },
                        "h": { "type": "number" },
                        "theta": { "type": "number" },
                        "lambda": { "type": "number" },
                        "epsilon": { "type": "number" }
                    },
                    "required": [ 
                        "cellDivisionRadius",
                        "degradationRate",
                        "synthesisRate",
                        "c",
                        "k1",
                        "k2",
                        "l1",
                        "l2",
                        "q",
                        "sigma",
                        "ki",
                        "ke",
                        "kt",
                        "alpha",
                        "h",
                        "theta",
                        "lambda",
                        "epsilon"
                    ]
                }
            },
            "required": [ "behaviorType" ]
        },
        "molecular": {
            "properties": {
                "boundaryCondition": {
                    "type": "string",
                    "enum": [ "Absorbing", "Periodic", "Reflective" ]
                },
                "initialDistribution": {
                    "type": "string",
                    "enum": [ "Centered", "Gaussian", "Uniform" ]
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/moleculeField"
                    }
                }
            },
            "required": [
                "boundaryCondition",
                "initialDistribution"
            ]
        },
        "optimization": {
            "type": "object",
            "properties": {
                "maxDegreeOfParallelism": {
                    "type": "integer"
                },
                "peformance": {
                    "type": "string",
                    "enum": [ "Fast", "LowMemory" ]
                }
            },
            "required": [ "maxDegreeOfParallelism", "peformance" ]
        },
        "simulation": {
            "type": "object",
            "title": "simulation setting",
            "properties": {
                "deltaTime": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "enable2DMode": { "type": "boolean" },
                "fieldRadius": {
                    "type": "number",
                    "minimum": 0,
                    "examples": [ 512, 1024, 2048 ]
                },
                "imageSize": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                },
                "outputInterval": {
                    "type": "integer",
                    "minimum": 1
                },
                "totalSteps": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                }
            },
            "required": [ "deltaTime", "fieldRadius", "imageSize", "outputInterval", "totalSteps" ]
        },
        "simulationModel": {
            "type": "object",
            "properties": {
                "simulationType": {
                    "type": "string",
                    "enum": [ "CellGrowth", "ClusterFormation", "ClusterRotation", "ClusterSprouting", "NetworkFormation", "Null", "User" ]
                },
                "cellGrowth": {
                    "type": "object",
                    "properties": {
                        "adhesiveRepulsionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "adhesiveRepulsionFactor" ]
                },
                "clusterFormation": {
                    "type": "object",
                    "properties": {
                        "adhesiveRepulsionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "lambda": {
                            "type": "number"
                        },
                        "remoteForceFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "adhesiveRepulsionFactor", "lambda", "remoteForceFactor" ]
                },
                "clusterRotation": {
                    "type": "object",
                    "properties": {
                        "adhesionDistanceThreshold": {
                            "type": "number",
                            "minimum": 0
                        },
                        "adhesionForceFactor": {
                            "type": "number",
                            "minimum": 0
                        },
                        "centralForceFactor": {
                            "type": "number",
                            "minimum": 0
                        },
                        "repulsionFactor": {
                            "type": "number",
                            "minimum": 0
                        },
                        "repulsionMaxDistance": {
                            "type": "number",
                            "minimum": 0
                        }
                    },
                    "required": [
                        "adhesionDistanceThreshold",
                        "adhesionForceFactor",
                        "centralForceFactor",
                        "repulsionFactor",
                        "repulsionMaxDistance"
                    ]
                },
                "clusterSprouting": {
                    "type": "object",
                    "properties": {
                        "adhesionThreshold": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "coefficientCd": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "contactDistance": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "followerAttractionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "globalAttractionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "lambda": {
                            "type": "number"
                        },
                        "leaderRepulsionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "leaderRepulsionMaxDistance": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },"leaderRepulsionMinDistance": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [
                        "adhesionThreshold",
                        "coefficientCd",
                        "contactDistance",
                        "followerAttractionFactor",
                        "globalAttractionFactor",
                        "lambda",
                        "leaderRepulsionFactor",
                        "leaderRepulsionMaxDistance",
                        "leaderRepulsionMinDistance"
                    ]
                },
                "networkFormation": {
                    "type": "object",
                    "properties": {
                        "adhesiveRepulsionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "attractionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "lambda": {
                            "type": "number"
                        },
                        "maxAttractionDistance": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "maxRepulsionDistance": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "minAttractionDistance": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "remoteForceFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "adhesiveRepulsionFactor", "attractionFactor", "lambda", "maxAttractionDistance", "maxRepulsionDistance", "minAttractionDistance", "remoteForceFactor" ]
                }
            },
            "required": [ "simulationType" ]
        }
    },
    "required": [
        "cell",
        "cellAlgorithm",
        "cellBehavior",
        "molecular",
        "optimization",
        "simulation",
        "simulationModel"
    ]
}