{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "cellsim config",
    "$defs": {
        "description": {
            "type": "object",
            "properties": {
                "language": { "type": "string", "examples": [ "en-us", "ja-jp" ] },
                "text": { "type": "string" }
            },
            "required": [
                "language",
                "text"
            ]
        },
        "descriptions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/description"
            },
            "minItems": 1,
            "uniqueItems": true
        }
    },
    "properties": {
        "cell": {
            "type": "object",
            "title": "cell congfig",
            "properties": {
                "cellCount": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                },
                "enableGrowth": { "type": "boolean" },
                "growthRate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "initialPlacementSeed": {
                    "type": "integer",
                    "minimum": 0
                },
                "isSensitiveToMolecules": { "type": "boolean" },
                "mass": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "type": {
                    "type": "string",
                    "enum": [ "Normal" ]
                }
            },
            "required": [ "cellCount", "enableGrowth", "growthRate", "initialPlacementSeed", "isSensitiveToMolecules", "mass", "radius", "type" ]
        },
        "cellAlgorithm": {
            "type": "object",
            "title": "cellAlgorithm config",
            "properties": {
                "algorithmType": {
                    "type": "string",
                    "enum": [ "BarnesHut", "CellList", "Naive", "Null", "ParticleMesh", "User" ]
                },
                "useClusterModel": { "type": "boolean" },
                "barnesHut": { "type": "object" },
                "cellList": {
                    "properties": {
                        "gridCountX": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                        },
                        "gridCountY": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                        },
                        "gridCountZ": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                        },
                        "searchRadius": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "gridCountX", "gridCountY", "gridCountZ", "searchRadius" ]
                },
                "particleMesh": { "type": "object" },
                "user": { "type": "object" }
            },
            "required": [ "algorithmType", "useClusterModel" ]
        },
        "cellBehavior": {
            "type": "object",
            "properties": {
                "behaviorType": {
                    "type": "string",
                    "enum": [ "MoleculeAware", "Normal", "User" ]
                },
                "moleculeAware": {
                    "type": "object",
                    "properties": {
                        "cellDivisionRadius": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "degradationRate": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "synthesisRate": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "cellDivisionRadius", "degradationRate", "synthesisRate" ]
                },
                "normal": {
                    "type": "object",
                    "properties": {
                        "cellDivisionRadius": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "cellDivisionRadius" ]
                },
                "user": { "type": "object" }
            },
            "required": [ "behaviorType" ]
        },
        "simulation": {
            "type": "object",
            "title": "simulation setting",
            "properties": {
                "deltaTime": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "enable2DMode": { "type": "boolean" },
                "fieldRadiusX": {
                    "type": "number",
                    "minimum": 0,
                    "examples": [ 512, 1024, 2048 ]
                },
                "fieldRadiusY": {
                    "type": "number",
                    "minimum": 0,
                    "examples": [ 512, 1024, 2048 ]
                },
                "fieldRadiusZ": {
                    "type": "number",
                    "minimum": 0,
                    "examples": [ 512, 1024, 2048 ]
                },
                "totalSteps": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                }
            },
            "required": [ "deltaTime", "fieldRadiusX", "fieldRadiusY", "fieldRadiusZ", "totalSteps" ]
        },
        "simulationModel": {
            "type": "object",
            "properties": {
                "simulationType": {
                    "type": "string",
                    "enum": [ "CellGrowth", "ClusterFormation", "ClusterRotation", "ClusterSprouting", "NetworkFormation", "Null", "User" ]
                },
                "cellGrowth": {
                    "type": "object",
                    "properties": {
                        "adhesiveRepulsionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "adhesiveRepulsionFactor" ]
                },
                "clusterFormation": {
                    "type": "object",
                    "properties": {
                        "adhesiveRepulsionFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "lambda": {
                            "type": "number"
                        },
                        "remoteForceFactor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [ "adhesiveRepulsionFactor", "lambda", "remoteForceFactor" ]
                }
            },
            "required": [ "simulationType" ]
        }
    },
    "required": [
        "cell",
        "cellAlgorithm",
        "cellBehavior",
        "simulation",
        "simulationModel"
    ]
}