{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "cellsim config",
    "$defs": {
        "description": {
            "type": "object",
            "properties": {
                "language": { "type": "string", "examples": [ "en-us", "ja-jp" ] },
                "text": { "type": "string" }
            },
            "required": [
                "language",
                "text"
            ]
        },
        "descriptions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/description"
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "cellCreateInfo": {
            "type": "object",
            "properties": {
                "behaviorType": {
                    "type": "string",
                    "enum": [
                        "MoleculeAware",
                        "Normal",
                        "User",
                        "WavePropagation"
                    ]
                },
                "cellCount": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                },
                "color": {
                    "type": "string"
                },
                "mass": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "typeName": {
                    "type": "string"
                },
                "behaviorParameters": {
                    "type": "object",
                    "properties": {
                
                        "moleculeAware": {
                            "type": "object",
                            "properties": {
                                "cellDivisionRadius": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "degradationRate": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "growthRate": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "synthesisRate": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                }
                            },
                            "required": [
                                "cellDivisionRadius",
                                "degradationRate",
                                "growthRate",
                                "synthesisRate"
                            ]
                        },
                        "normal": {
                            "type": "object",
                            "properties": {
                                "cellDivisionRadius": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "growthRate": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                }
                            },
                            "required": [
                                "cellDivisionRadius",
                                "growthRate"
                            ]
                        },
                        "user": { "type": "object" },
                        "wavePropagation": {
                            "type": "object",
                            "properties": {
                                "cellDivisionRadius": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "growthRate": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "degradationRate": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "synthesisRate": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "c": { "type": "number" },
                                "k1": { "type": "number" },
                                "k2": { "type": "number" },
                                "l1": { "type": "number" },
                                "l2": { "type": "number" },
                                "q": { "type": "number" },
                                "sigma": { "type": "number" },
                                "ki": { "type": "number" },
                                "ke": { "type": "number" },
                                "kt": { "type": "number" },
                                "alpha": { "type": "number" },
                                "h": { "type": "number" },
                                "theta": { "type": "number" },
                                "lambda": { "type": "number" },
                                "epsilon": { "type": "number" }
                            },
                            "required": [ 
                                "cellDivisionRadius",
                                "growthRate",
                                "degradationRate",
                                "synthesisRate",
                                "c",
                                "k1",
                                "k2",
                                "l1",
                                "l2",
                                "q",
                                "sigma",
                                "ki",
                                "ke",
                                "kt",
                                "alpha",
                                "h",
                                "theta",
                                "lambda",
                                "epsilon"
                            ]
                        }
                    }
                },
                "modelParameters": {
                    "type": "object",
                    "properties": {
                        "cellGrowth": {
                            "type": "object",
                            "properties": {
                                "adhesiveRepulsionFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                }
                            },
                            "required": [
                                "adhesiveRepulsionFactor"
                            ]
                        },
                        "clusterFormation": {
                            "type": "object",
                            "properties": {
                                "adhesiveRepulsionFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "lambda": {
                                    "type": "number"
                                },
                                "remoteForceFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                }
                            },
                            "required": [
                                "adhesiveRepulsionFactor",
                                "lambda",
                                "remoteForceFactor"
                            ]
                        },
                        "clusterRotation": {
                            "type": "object",
                            "properties": {
                                "adhesionDistanceThreshold": {
                                    "type": "number",
                                    "minimum": 0
                                },
                                "adhesionForceFactor": {
                                    "type": "number",
                                    "minimum": 0
                                },
                                "centralForceFactor": {
                                    "type": "number",
                                    "minimum": 0
                                },
                                "repulsionFactor": {
                                    "type": "number",
                                    "minimum": 0
                                },
                                "repulsionMaxDistance": {
                                    "type": "number",
                                    "minimum": 0
                                }
                            },
                            "required": [
                                "adhesionDistanceThreshold",
                                "adhesionForceFactor",
                                "centralForceFactor",
                                "repulsionFactor",
                                "repulsionMaxDistance"
                            ]
                        },
                        "clusterSprouting": {
                            "type": "object",
                            "properties": {
                                "adhesionThreshold": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "coefficientCd": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "followerAttractionFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "globalAttractionFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "lambda": {
                                    "type": "number"
                                },
                                "leaderRepulsionFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "leaderRepulsionMaxDistance": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },"leaderRepulsionMinDistance": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                }
                            },
                            "required": [
                                "adhesionThreshold",
                                "coefficientCd",
                                "followerAttractionFactor",
                                "globalAttractionFactor",
                                "lambda",
                                "leaderRepulsionFactor",
                                "leaderRepulsionMaxDistance",
                                "leaderRepulsionMinDistance"
                            ]
                        },
                        "networkFormation": {
                            "type": "object",
                            "properties": {
                                "adhesiveRepulsionFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "attractionFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "lambda": {
                                    "type": "number"
                                },
                                "maxRepulsionDistance": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "minAttractionDistance": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "remoteForceFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                }
                            },
                            "required": [
                                "adhesiveRepulsionFactor",
                                "attractionFactor",
                                "lambda",
                                "maxRepulsionDistance",
                                "minAttractionDistance",
                                "remoteForceFactor"
                            ]
                        }
                    }
                }
            },
            "required": [
                "behaviorType",
                "cellCount",
                "color",
                "mass",
                "radius",
                "typeName",
                "behaviorParameters",
                "modelParameters"
            ]
        },
        "moleculeField": {
            "type": "object",
            "properties": {
                "boundaryCondition": {
                    "type": "string",
                    "enum": [
                        "Absorbing",
                        "Periodic",
                        "Reflective"
                    ]
                },
                "colorIntensityThreshold": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "gridCount": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                },
                "moleculeAmount": {
                    "type": "number",
                    "minimum": 0
                },
                "moleculeKind": {
                    "type": "string"
                },
                "initialDistribution": {
                    "type": "string",
                    "enum": [
                        "Centered",
                        "Uniform"
                    ]
                },
                "behaviorType": {
                    "type": "string",
                    "enum": [
                        "Normal",
                        "Null",
                        "User"
                    ]
                },
                "behaviorParameters": {
                    "type": "object",
                    "properties": {
                        "normalBehavior": {
                            "type": "object",
                            "properties": {
                                "diffusionFactor": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                }
                            },
                            "required": [
                                "diffusionFactor"
                            ]
                        }
                    }
                }
            },
            "required": [
                "behaviorType",
                "boundaryCondition",
                "colorIntensityThreshold",
                "gridCount",
                "initialDistribution",
                "moleculeAmount",
                "moleculeKind",
                "behaviorParameters"
            ]
        }
    },
    "properties": {
        "cell": {
            "type": "object",
            "properties": {
                "cells": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/cellCreateInfo"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "enableGrowth": {
                    "type": "boolean"
                },
                "initialPlacementRadius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "initialPlacementSeed": {
                    "type": "integer",
                    "minimum": 0
                },
                "isSensitiveToMolecules": {
                    "type": "boolean"
                }
                
            },
            "required": [
                "cells",
                "enableGrowth",
                "initialPlacementRadius",
                "initialPlacementSeed",
                "isSensitiveToMolecules"
            ]
        },
        "cellAlgorithm": {
            "type": "object",
            "properties": {
                "algorithmType": {
                    "type": "string",
                    "enum": [
                        "BarnesHut",
                        "CellList",
                        "Naive",
                        "Null",
                        "User"
                    ]
                },
                "useClusterModel": {
                    "type": "boolean"
                },
                "barnesHut": {
                    "type": "object",
                    "properties": {
                        "theta": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "theta"
                    ]
                },
                "cellList": {
                    "type": "object",
                    "properties": {
                        "gridCount": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                        },
                        "searchRadius": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [
                        "gridCount",
                        "searchRadius"
                    ]
                },
                "particleMesh": {
                    "type": "object"
                },
                "user": {
                    "type": "object"
                }
            },
            "required": [
                "algorithmType",
                "useClusterModel",
                "cellList"
            ]
        },
        "molecular": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/moleculeField"
            }
    
        },
        "optimization": {
            "type": "object",
            "properties": {
                "maxDegreeOfParallelism": {
                    "type": "integer"
                },
                "peformance": {
                    "type": "string",
                    "enum": [
                        "Fast",
                        "LowMemory"
                    ]
                }
            },
            "required": [
                "maxDegreeOfParallelism",
                "peformance"
            ]
        },
        "simulation": {
            "type": "object",
            "title": "simulation setting",
            "properties": {
                "deltaTime": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "enable2dMode": {
                    "type": "boolean"
                },
                "fieldRadius": {
                    "type": "number",
                    "minimum": 0,
                    "examples": [
                        512,
                        1024,
                        2048
                    ]
                },
                "imageSize": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                },
                "outputInterval": {
                    "type": "integer",
                    "minimum": 1
                },
                "totalSteps": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                }
            },
            "required": [
                "deltaTime",
                "enable2dMode",
                "fieldRadius",
                "imageSize",
                "outputInterval",
                "totalSteps"
            ]
        },
        "simulationModel": {
            "type": "object",
            "properties": {
                "simulationType": {
                    "type": "string",
                    "enum": [
                        "CellGrowth",
                        "ClusterFormation",
                        "ClusterRotation",
                        "ClusterSprouting",
                        "NetworkFormation",
                        "Null",
                        "User"
                    ]
                },
                "clusterSprouting": {
                    "type": "object",
                    "properties": {
                        "contactDistance": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [
                        "contactDistance"
                    ]
                },
                "networkFormation": {
                    "type": "object",
                    "properties": {
                        "maxAttractionDistance": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "required": [
                        "maxAttractionDistance"
                    ]
                }
            },
            "required": [
                "simulationType"
            ]
        }
    },
    "required": [
        "cell",
        "cellAlgorithm",
        "molecular",
        "optimization",
        "simulation",
        "simulationModel"
    ]
}